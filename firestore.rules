rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // FUNCIONES GLOBALES
    // ==========================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == "bellanco3@gmail.com";
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isPlaceholder(docId) {
      return docId == "_placeholder";
    }

    // C5/T4 — Validación de esquema (allowlist) de escrituras: un cliente hostil autenticado no puede
    // inyectar campos arbitrarios en su propio doc. hasOnly admite un subconjunto, así que las escrituras
    // parciales por merge siguen valiendo mientras no introduzcan claves fuera de la lista.
    function profileWriteIsValid() {
      return request.resource.data.uid is string
        && request.resource.data.uid == request.auth.uid
        // SIN `email`: el perfil lo lee cualquier usuario autenticado, así que el correo no puede vivir aquí. El
        // código dejó de escribirlo hace tiempo y los documentos que lo arrastraban ya se purgaron
        // (`scripts/purge-profile-pii.js`); esto cierra la puerta para que no pueda volver por una regresión.
        && request.resource.data.keys().hasOnly([
          "schemaVersion", "uid", "profileId", "displayName", "photoURL", "social", "updatedAt", "tier",
          "createdAt", "achievements"
        ])
        && profileTierNotSelfAssigned()
        && profileCreatedAtIsImmutable()
        && profileFieldsAreSane();
    }

    // C7 — Validación de TIPO y TAMAÑO del contenido del perfil público. El `hasOnly` de arriba impedía
    // inventarse campos, pero no decía NADA de lo que se guarda dentro de los permitidos: un cliente
    // autenticado hostil podía escribir en SU PROPIO documento un `displayName` de cientos de KB o un
    // `photoURL` con `javascript:`, y este documento lo lee todo el directorio social (hasta
    // SOCIAL_DIRECTORY_LIMIT perfiles por apertura del hub). Es decir, un usuario podía inflar o envenenar
    // lo que se descarga y se pinta en el navegador de los demás. Los límites son deliberadamente más
    // holgados que los del cliente (el editor corta el nick en 60): aquí se trata de acotar el abuso, no de
    // duplicar la validación de la UI.
    //
    // Cada campo se valida SOLO SI ESTÁ PRESENTE, y es la parte que no se puede omitir: en un `update` por
    // merge `request.resource.data` es el documento RESULTANTE, así que los perfiles legacy llegan aquí con
    // campos que las escrituras nuevas ya no mandan (`email`, `social.gistId`, `social.githubToken`), y
    // exigirlos denegaría toda escritura sobre ellos —incluida la del auto-saneado que existe justo para
    // limpiarlos—. Sobre las claves de `social` SÍ hay un `hasOnly` (ver `profileSocialIsSane`), y cerrarlo
    // tuvo su precio: un documento antiguo con una subclave que no esté en esa lista —`social.githubToken`, el
    // PAT en claro— queda congelado hasta que una escritura la borre, y su dueño no puede arreglarlo a mano
    // (`profiles` solo lo escribe él o el admin). Se pudo cerrar por dos cosas: antes se pasó la purga de restos
    // legacy (`scripts/purge-profile-pii.js`), y el auto-saneado del arranque borra el `email` y las tres
    // subclaves viejas de `social` EN LA MISMA escritura (`healOwnLegacyProfile`), así que el documento
    // RESULTANTE que llega aquí ya cumple la allowlist. Lo que sigue pendiente —anotado en SECURITY.md— es sacar
    // de ella `gistId` y `gamesGistId`, que ya viven en `privateConfig`; eso pide repasar antes los datos reales
    // con `npm run audit:rules`.
    //
    // Las fechas admiten número Y timestamp a propósito: el cliente escribe `serverTimestamp()` (que las
    // reglas ven como timestamp) y los documentos viejos llevan milisegundos.
    function profileFieldsAreSane() {
      return (!("schemaVersion" in request.resource.data) || request.resource.data.schemaVersion is number)
        && (!("profileId" in request.resource.data)
            || (request.resource.data.profileId is string && request.resource.data.profileId.size() <= 128))
        && (!("displayName" in request.resource.data)
            || (request.resource.data.displayName is string && request.resource.data.displayName.size() <= 120))
        && profilePhotoUrlIsSafe()
        && (!("social" in request.resource.data) || profileSocialIsSane())
        && (!("updatedAt" in request.resource.data)
            || request.resource.data.updatedAt is number || request.resource.data.updatedAt is timestamp)
        && (!("createdAt" in request.resource.data)
            || request.resource.data.createdAt is number || request.resource.data.createdAt is timestamp)
        && (!("achievements" in request.resource.data) || profileAchievementsAreSane());
    }

    /**
     * EL ESPEJO DE LOGROS (`profiles/{uid}.achievements`), que lo escribe su dueño y lo lee cualquier autenticado.
     *
     * Es `{ v, at, list }`: la versión de la gramática, el sello de la publicación y el mapa de bits en base64url
     * (ver `core/achievements/pack.ts`). El TOPE DE `list` ES EL MISMO NÚMERO que aplica el empaquetador
     * (`ACHIEVEMENTS_LIST_MAX`, 1024): esa cadena se la descarga entera el directorio social de todo el mundo, así
     * que el límite tiene que estar también aquí y no solo en el cliente que la escribe.
     *
     * NO se valida el CONTENIDO de `list` —Firestore no puede parsear base64url ni recorrer una cola de índices— y
     * no hace falta: quien la lee es un parser deliberadamente defensivo (§9.3) que ante cualquier cosa rara pinta
     * una vitrina vacía en vez de lanzar. Lo que sí importa aquí es que nadie pueda usar este campo como almacén.
     */
    function profileAchievementsAreSane() {
      return request.resource.data.achievements is map
        && request.resource.data.achievements.keys().hasOnly(["v", "at", "list"])
        && (!("v" in request.resource.data.achievements) || request.resource.data.achievements.v is int)
        && (!("at" in request.resource.data.achievements)
            || request.resource.data.achievements.at is number
            || request.resource.data.achievements.at is timestamp)
        && (!("list" in request.resource.data.achievements)
            || (request.resource.data.achievements.list is string
                && request.resource.data.achievements.list.size() <= 1024));
    }

    // La foto es el único campo del perfil que acaba en un atributo de URL (`<img src>`), así que aquí no
    // basta con el tamaño: se exige `https://` explícitamente. Eso es lo que cierra la vía `javascript:` /
    // `data:` en el navegador de quien mira el directorio. La cadena vacía se admite porque es el valor
    // normal de quien no tiene foto de Google.
    function profilePhotoUrlIsSafe() {
      return !("photoURL" in request.resource.data)
        || (request.resource.data.photoURL is string
            && request.resource.data.photoURL.size() <= 512
            && (request.resource.data.photoURL == "" || request.resource.data.photoURL.matches("^https://.+")));
    }

    // El mapa `social` del perfil PÚBLICO, que lee cualquier usuario autenticado.
    //
    // EL CAMBIO ES EL `hasOnly`. Antes se validaban las subclaves conocidas pero una inesperada pasaba, así que un
    // cliente hostil podía inflar su propio perfil con lo que quisiera —del tamaño que quisiera— y todo el
    // directorio se lo descargaba. De paso cierra la puerta a `social.githubToken`: el PAT en claro que
    // arrastraban los perfiles antiguos hoy PASA esta validación, porque sin allowlist nadie lo mira.
    //
    // `gistId` y `gamesGistId` SIGUEN admitidos, y no por descuido. El código ya no los escribe (los purga con
    // `deleteField()`), pero el cutover de identidad del panel los DEPOSITA a propósito en el documento canónico
    // para que el saneado del dueño los mueva a `privateConfig` y los borre: es lo único que salva esos ids
    // cuando el perfil huérfano desaparece. Prohibirlos aquí dejaría ese documento congelado —su dueño no podría
    // escribir nada— justo en el caso que el cutover viene a rescatar.
    //
    // OJO, hueco conocido: `firebaseProfileHealRepository` purga `social.gamesGistId` y `social.githubToken`,
    // pero NO `social.gistId`; ese se limpia por la otra vía (`upsertProfileSocialReferences`, al guardar el
    // perfil). Cerrar `gistId` aquí exige antes que el saneado lo rescate y lo purgue como hace con los otros.
    function profileSocialIsSane() {
      return request.resource.data.social is map
        && request.resource.data.social.keys().hasOnly(["enabled", "etag", "gistId", "gamesGistId"])
        && (!("enabled" in request.resource.data.social) || request.resource.data.social.enabled is bool)
        && (!("etag" in request.resource.data.social)
            || request.resource.data.social.etag == null
            || (request.resource.data.social.etag is string && request.resource.data.social.etag.size() <= 256))
        && (!("gistId" in request.resource.data.social)
            || (request.resource.data.social.gistId is string && request.resource.data.social.gistId.size() <= 128))
        && (!("gamesGistId" in request.resource.data.social)
            || (request.resource.data.social.gamesGistId is string && request.resource.data.social.gamesGistId.size() <= 128));
    }

    // FECHA DE ALTA (`createdAt`). Se sella UNA vez, al crear el perfil, y ya no se puede tocar: si el dueño
    // pudiera reescribirla, no serviría para nada (falsearía su antigüedad y taparía justo el comportamiento raro
    // que el panel busca detectar). Escribirla es legítimo la primera vez porque es el propio cliente del usuario
    // quien crea su documento; a partir de ahí queda congelada, incluso para él.
    //
    // Igual que con `tier`, va en la allowlist de arriba por obligación: en un `update`, `request.resource.data`
    // es el documento RESULTANTE, así que sin la clave se denegaría toda escritura merge de un perfil que ya la
    // tenga. Y también se exige que SIGA presente: si no, quitarla con `deleteField()` sería otra vía de borrar
    // el rastro (la misma lección que costó descubrir con el rango).
    function profileCreatedAtIsImmutable() {
      return (resource == null || !("createdAt" in resource.data))
        ? true // aún no existe: el cliente puede sellarla al crear el perfil
        : ("createdAt" in request.resource.data && request.resource.data.createdAt == resource.data.createdAt);
    }

    // El rango del perfil (bronce/plata/oro/mithril) lo asigna EL ADMIN desde `/admin`; el dueño no.
    //
    // `tier` TIENE que estar en la allowlist de arriba aunque el cliente nunca lo escriba: en un `update`,
    // `request.resource.data` es el documento RESULTANTE completo, no solo las claves que se envían. En cuanto el
    // admin le pusiera un tier a alguien, `hasOnly` sin "tier" denegaría todas las escrituras merge de ese usuario
    // sobre su propio perfil (nombre, foto, gist) y le dejaría el perfil congelado.
    //
    // Con la clave admitida, el dueño solo puede DEJARLO EXACTAMENTE COMO ESTÁ:
    //   - si su documento no tiene rango, tampoco puede estrenárselo;
    //   - si lo tiene, la escritura debe conservarlo con el mismo valor.
    // La segunda mitad importa tanto como la primera: sin ella, quitar el campo (con `deleteField()` o
    // sobrescribiendo el documento sin él) se colaba como "no hay tier en la escritura, luego no se está
    // asignando" y permitía autodegradarse a bronce. Escalar nunca fue posible; editarlo hacia abajo, sí.
    // No rompe nada legítimo: TODAS las escrituras de la app sobre `profiles` son `merge`, y un merge conserva
    // el campo sin mencionarlo. El admin se salta esta validación entera por la rama `isAdmin()`.
    function profileTierNotSelfAssigned() {
      return (resource == null || !("tier" in resource.data))
        ? !("tier" in request.resource.data)
        : ("tier" in request.resource.data && request.resource.data.tier == resource.data.tier);
    }

    function privateConfigWriteIsValid() {
      return request.resource.data.keys().hasOnly([
        "schemaVersion", "profileId", "gamesGistId", "socialGistId", "gamesChunks", "socialChunks", "encryptedGithubToken"
      ]);
    }

    // ST9 — validación de esquema (allowlist) de userMap: un dueño no puede inyectar campos arbitrarios/payloads
    // grandes en su propio doc. Solo `profileId` + `schemaVersion`.
    function userMapWriteIsValid() {
      return request.resource.data.keys().hasOnly(["profileId", "schemaVersion"]);
    }

    // F2 — publicConfig: preferencias NO sensibles del dueño (escala de puntuación, y F1: apariencia
    // = paleta + modo claro/oscuro). Separada de privateConfig (token/ids). Allowlist estricta de claves.
    // L4 — `consent`: aceptación de los términos/privacidad (versión + sello). Va aquí y no en el perfil público
    // porque es dato del dueño, no del directorio, y así le sigue entre dispositivos. `effects` faltaba en la
    // allowlist aunque el cliente ya lo escribía (`appearancePreferenceRepository`): sin él, esa preferencia se
    // denegaba en silencio y nunca sincronizaba.
    /**
     * CONFIGURACIÓN DEL CATÁLOGO DE LOGROS (`appConfig/achievements`), leída por todo el mundo con sesión y
     * escrita por el panel de administración — salvo `open`, que la adelanta cualquiera (ver abajo).
     *
     * Lleva dos mapas y los dos son SOLO PRESENTACIÓN: no tocan ningún `id`, ni el espejo publicado, ni lo que
     * nadie tenga conseguido.
     *
     *   · `hidden` — clave de escalera → booleano. `true` = oculta, `false` = a la vista, ausente = lo que diga
     *     el código. Es una DECISIÓN de producto: solo el admin.
     *   · `open`   — clave de escalera → `id` del escalón más alto al que ha llegado alguien. Es lo que abre la
     *     escalera para todo el mundo: en cuanto un usuario ve un escalón, se le enseña a todos. Es una MEDICIÓN,
     *     así que la adelanta el cliente de quien llega ahí (`openFrontierUpdateIsValid`) y también la publica el
     *     panel midiendo los espejos del censo.
     *   · `extraSteps` — clave de escalera → umbrales que el panel ha AÑADIDO a esa escalera sin desplegar
     *     (§6.4bis). Este SÍ amplía el catálogo: los clientes lo reconstruyen al leerlo, así que el escalón se
     *     desbloquea, cuenta en la fracción y viaja en el espejo por su `id` (nunca por un bit: el orden de bits
     *     sigue congelado en el código, y es lo que hace esto seguro). Solo el admin, como `hidden`, y por el
     *     mismo motivo: es una decisión de producto.
     *
     * Se acota como el resto: solo esas dos claves, y cada mapa con tope de entradas para que este documento no
     * se pueda usar como almacén de nada. Los VALORES de `open` no se validan uno a uno —Firestore no sabe
     * recorrer un mapa— pero no hace falta: el cliente descarta lo que no sea cadena (`sanitizeOpen`) y un `id`
     * que no exista en el catálogo se ignora al aplicarlo (`openThrough`).
     */
    function achievementsConfigIsValid() {
      return request.resource.data.keys().hasOnly(["hidden", "open", "extraSteps"])
        && (!("hidden" in request.resource.data)
            || (request.resource.data.hidden is map && request.resource.data.hidden.size() <= 100))
        && (!("open" in request.resource.data)
            || (request.resource.data.open is map && request.resource.data.open.size() <= 100))
        && (!("extraSteps" in request.resource.data)
            || (request.resource.data.extraSteps is map && request.resource.data.extraSteps.size() <= 100));
    }

    /**
     * LA APERTURA LA ADELANTA CUALQUIERA CON SESIÓN, y es la regla que hace verdad la promesa del `open`: en
     * cuanto un usuario alcanza un escalón, ese escalón queda abierto para TODOS, así que el denominador de la
     * fracción («196 de 249») es el mismo en todos los aparatos. Mientras solo el admin podía escribirlo, el mapa
     * se quedaba vacío entre publicación y publicación y cada cliente abría con su propio progreso: quien tenía
     * 196 medallas contaba sobre 249 y quien empezaba, sobre 55, con el mismo catálogo delante.
     *
     * ES UNA MEDICIÓN, NO UNA DECISIÓN, y de ahí que se pueda dejar en manos de todos: dice que alguien llegó a
     * un escalón, sin quién ni cuándo. `hidden` —que sí es una decisión de producto— sigue siendo del admin, y
     * esto no lo puede tocar.
     *
     * SOLO `open` Y SOLO HACIA DELANTE, hasta donde una regla puede comprobarlo: se acota la clave que cambia y
     * se exige que no DESAPAREZCA ninguna escalera ya abierta. Los valores no se validan uno a uno —Firestore no
     * sabe recorrer un mapa, ni conoce el orden de los escalones—, pero el daño posible es una cifra de cabecera
     * distinta durante un rato: nada de lo que nadie tenga conseguido depende de este documento.
     */
    function openFrontierCreateIsValid(docId) {
      return docId == "achievements"
        && request.resource.data.keys().hasOnly(["open"])
        && request.resource.data.open is map
        && request.resource.data.open.size() <= 100;
    }

    function openFrontierUpdateIsValid(docId) {
      return docId == "achievements"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["open"])
        && request.resource.data.open is map
        && request.resource.data.open.size() <= 100
        && (!("open" in resource.data)
            || request.resource.data.open.keys().hasAll(resource.data.open.keys()));
    }

    function publicConfigWriteIsValid() {
      return request.resource.data.keys().hasOnly(["schemaVersion", "scoreScale", "palette", "theme", "uppercase", "showSteamButton", "effects", "consent", "feedMoveTabs"])
        && (!("scoreScale" in request.resource.data)
            || request.resource.data.scoreScale in ["stars", "grade"])
        && (!("theme" in request.resource.data)
            || request.resource.data.theme in ["dark", "light"])
        && (!("palette" in request.resource.data)
            || (request.resource.data.palette is string && request.resource.data.palette.size() <= 32))
        && (!("uppercase" in request.resource.data)
            || request.resource.data.uppercase is bool)
        && (!("showSteamButton" in request.resource.data)
            || request.resource.data.showSteamButton is bool)
        && (!("effects" in request.resource.data)
            || request.resource.data.effects is bool)
        // F4 — listas de las que su dueño ve los mensajes de actividad: letras de lista ('cevp'), nunca más de
        // cuatro. Se acota el tamaño como en `palette`: es una preferencia, no un sitio donde guardar texto.
        && (!("feedMoveTabs" in request.resource.data)
            || (request.resource.data.feedMoveTabs is string && request.resource.data.feedMoveTabs.size() <= 4))
        && (!("consent" in request.resource.data)
            || (request.resource.data.consent.keys().hasOnly(["version", "agreedAt"])
                && request.resource.data.consent.version is string
                && request.resource.data.consent.version.size() <= 32
                && request.resource.data.consent.agreedAt is number));
    }

    // ==========================================
    // COLECCION: PROFILES
    // ==========================================

    match /profiles/{userId} {
      // IMPORTANTE:
      // Lectura social compatible con consultas de coleccion:
      // - Admin
      // - Propietario
      // - Usuarios autenticados sobre perfiles con social.enabled == true
      //
      // Nota: Se evita condicionar la lectura con !isPlaceholder(userId)
      // para no romper consultas de coleccion (query rules inference).
      allow read: if
        isAdmin() ||
        isOwner(userId) ||
        (
          isSignedIn() &&
          resource.data.keys().hasAny(['social']) &&
          resource.data.social.enabled == true
        );

      // Crear o editar perfil propio (uid coincidente + esquema válido) o ser admin.
      allow create, update: if !isPlaceholder(userId) && (
        isAdmin() ||
        (
          isOwner(userId) &&
          profileWriteIsValid()
        )
      );

      // L3 — derecho de supresión (RGPD art. 17): el dueño puede borrar SU perfil desde la app; el admin, cualquiera
      // (salvo el placeholder). Antes solo podía el admin, así que el borrado de cuenta era imposible sin intervención
      // manual.
      allow delete: if !isPlaceholder(userId) && (isAdmin() || isOwner(userId));
    }

    // ==========================================
    // COLECCION: PRIVATE CONFIG (migración — solo el dueño)
    // Guarda ids de gist + el token de GitHub CIFRADO (recuperación cross-device).
    // El doc se identifica por el uid; nunca es legible por otros.
    // ==========================================

    // L3 — el borrado se separa de create/update en las tres colecciones owner-only: en un `delete` no hay
    // `request.resource`, así que la función de validación de esquema falla y `allow write` denegaba SIEMPRE el
    // borrado. Sin esta separación, el usuario no puede eliminar su propia cuenta.
    match /privateConfig/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && privateConfigWriteIsValid();
      allow delete: if isOwner(userId);
    }

    // ==========================================
    // COLECCION: PUBLIC CONFIG (F2 — preferencias no sensibles del dueño)
    // Escala de puntuación (estrellas/nota) por usuario, para que le siga entre dispositivos.
    // Solo el dueño lee/escribe su propia entrada; validación de esquema por allowlist.
    // ==========================================

    match /publicConfig/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && publicConfigWriteIsValid();
      allow delete: if isOwner(userId);
    }

    // ==========================================
    // COLECCION: USER MAP (migración — mapa privado uid -> profileId)
    // Solo el dueño escribe/lee su propia entrada.
    // ==========================================

    match /userMap/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && userMapWriteIsValid();
      allow delete: if isOwner(userId);
    }

    // ==========================================
    // COLECCION: FRIENDSHIPS (amistad con aceptación mutua)
    // Un doc por par no ordenado, id canónico `minUid__maxUid`. Solo los participantes leen/borran.
    // Campos denormalizados: cada parte escribe SOLO los suyos (requester en create, recipient al aceptar).
    // ==========================================

    match /friendships/{docId} {
      // Solo en update/delete (operaciones sobre un doc concreto → `resource` poblado). La LECTURA no usa esta
      // función: en `list` el acceso a `resource.data` da "Null value error" y hay que evitarlo (ver `allow read`).
      function isFriendshipParticipant() {
        return isSignedIn() && request.auth.uid in resource.data.users;
      }

      // C7 — mismo agujero que en `profiles`, y por la misma razón: los campos denormalizados de cada parte
      // (nombre, foto e ids de gist) los PINTA la otra parte —`otherPhoto` acaba en un `<img src>` del hub—,
      // así que hay que acotar tipo y tamaño y exigir `https://` en la foto. Sin esto, quien envía una
      // petición de amistad podía colocar una URL `javascript:` o un nombre de cientos de KB en la bandeja
      // de otro usuario.
      //
      // `null` se admite explícitamente: en un update, `request.resource.data` es el documento resultante e
      // incluye los campos de la OTRA parte, y un doc antiguo pudo guardar un nulo ahí. Denegarlo dejaría la
      // amistad imposible de sanear o de aceptar, que es peor que el dato flojo que se pretende evitar.
      function denormTextIsSane(value) {
        return value == null || (value is string && value.size() <= 120);
      }
      function denormPhotoIsSane(value) {
        return value == null
          || (value is string && value.size() <= 512 && (value == "" || value.matches("^https://.+")));
      }
      function denormGistIdIsSane(value) {
        return value == null || (value is string && value.size() <= 128);
      }
      function friendshipFieldsAreSane() {
        return (!("requesterName" in request.resource.data) || denormTextIsSane(request.resource.data.requesterName))
          && (!("recipientName" in request.resource.data) || denormTextIsSane(request.resource.data.recipientName))
          && (!("requesterPhoto" in request.resource.data) || denormPhotoIsSane(request.resource.data.requesterPhoto))
          && (!("recipientPhoto" in request.resource.data) || denormPhotoIsSane(request.resource.data.recipientPhoto))
          && (!("requesterSocialGistId" in request.resource.data) || denormGistIdIsSane(request.resource.data.requesterSocialGistId))
          && (!("recipientSocialGistId" in request.resource.data) || denormGistIdIsSane(request.resource.data.recipientSocialGistId))
          && (!("requesterGamesGistId" in request.resource.data) || denormGistIdIsSane(request.resource.data.requesterGamesGistId))
          && (!("recipientGamesGistId" in request.resource.data) || denormGistIdIsSane(request.resource.data.recipientGamesGistId));
      }

      // Crear petición: solo el requester, id/orden canónico, estado pending y allowlist de sus propios campos.
      function newFriendshipIsValid() {
        return request.resource.data.keys().hasOnly([
            "users", "requester", "recipient", "status", "createdAt", "updatedAt",
            "requesterName", "requesterPhoto", "requesterSocialGistId", "requesterGamesGistId"
          ])
          && request.resource.data.users.size() == 2
          && request.resource.data.users[0] < request.resource.data.users[1]
          && docId == request.resource.data.users[0] + "__" + request.resource.data.users[1]
          && request.auth.uid == request.resource.data.requester
          && request.resource.data.requester in request.resource.data.users
          && request.resource.data.recipient in request.resource.data.users
          && request.resource.data.recipient != request.resource.data.requester
          && request.resource.data.status == "pending"
          && friendshipFieldsAreSane();
      }

      // Aceptar: solo el recipient, pending -> accepted, escribiendo SOLO sus campos denormalizados + updatedAt.
      function friendshipAcceptTransition() {
        return request.auth.uid == resource.data.recipient
          && resource.data.status == "pending"
          && request.resource.data.status == "accepted"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "status", "updatedAt", "recipientName", "recipientPhoto", "recipientSocialGistId", "recipientGamesGistId"
          ]);
      }

      // Sanear: cada parte refresca SOLO sus propios campos denormalizados (nombre/foto), sin tocar estado/identidad.
      function friendshipHealOwnFields() {
        return request.resource.data.status == resource.data.status
          && request.resource.data.users == resource.data.users
          && request.resource.data.requester == resource.data.requester
          && request.resource.data.recipient == resource.data.recipient
          && (
            (request.auth.uid == resource.data.requester
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                "requesterName", "requesterPhoto", "requesterSocialGistId", "requesterGamesGistId", "updatedAt"]))
            ||
            (request.auth.uid == resource.data.recipient
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                "recipientName", "recipientPhoto", "recipientSocialGistId", "recipientGamesGistId", "updatedAt"]))
          );
      }

      // Lectura: admin, o participante. Sin `!isPlaceholder(docId)` (en `list` el docId no está ligado y romper el
      // acceso a `resource.data` da "Null value error" que deniega TODA la consulta del feed/bandeja). El placeholder
      // no tiene `users`, así que la consulta `array-contains` nunca lo devuelve.
      allow read:   if isAdmin() || (isSignedIn() && request.auth.uid in resource.data.users);
      allow create: if !isPlaceholder(docId) && (isAdmin() || newFriendshipIsValid());
      allow update: if !isPlaceholder(docId) && (isAdmin() || (isFriendshipParticipant() && friendshipFieldsAreSane() && (friendshipAcceptTransition() || friendshipHealOwnFields())));
      allow delete: if !isPlaceholder(docId) && (isAdmin() || isFriendshipParticipant()); // cancelar / rechazar / eliminar
    }

    // ==========================================
    // COLECCIONES EN FASE 1 (SOLO ADMIN)
    // ==========================================

    // Aplicable a: recommendations, activity_events
    match /recommendations/{docId} {
      allow read, write: if !isPlaceholder(docId) && isAdmin();
    }

    match /activity_events/{docId} {
      allow read, write: if !isPlaceholder(docId) && isAdmin();
    }

    // ==========================================
    // CONFIGURACIÓN GLOBAL (LEE TODO EL MUNDO, ESCRIBE EL ADMIN)
    // ==========================================

    // Ajustes del catálogo de logros que el panel cambia sin desplegar (hoy: qué escaleras están ocultas).
    // LECTURA con sesión y ESCRITURA solo `isAdmin()`. Sin este documento —o sin sesión, o sin red— la app cae a
    // lo que dice el código, que es el lado seguro: un logro oculto sigue oculto.
    match /appConfig/{docId} {
      allow read: if isSignedIn();
      allow create: if !isPlaceholder(docId)
        && ((isAdmin() && achievementsConfigIsValid())
            || (isSignedIn() && openFrontierCreateIsValid(docId)));
      allow update: if !isPlaceholder(docId)
        && ((isAdmin() && achievementsConfigIsValid())
            || (isSignedIn() && openFrontierUpdateIsValid(docId)));
      allow delete: if !isPlaceholder(docId) && isAdmin();
    }

    // ==========================================
    // REGLA DE CIERRE
    // ==========================================

    // Denegar cualquier otro acceso no especificado explicitamente arriba
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
