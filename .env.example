VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_ENABLE_ANALYTICS=true

# App Check — clave de SITIO de reCAPTCHA v3 (PÚBLICA: aparece en el build, como el client_id de GitHub).
# La clave SECRETA no va aquí ni en el repositorio: se pega una sola vez en la consola de Firebase.
# Déjalo VACÍO para desactivar App Check por completo (no se carga nada de Google). Ver
# `src/model/repository/appCheckRepository.ts`, que documenta cómo apagarlo o retirarlo.
VITE_RECAPTCHA_SITE_KEY=
# Solo DESARROLLO: `true` hace que el SDK imprima en consola un token de depuración con forma de UUID, que se
# registra en la consola de Firebase para poder probar App Check en localhost (reCAPTCHA no emite tokens para
# dominios no dados de alta). En build de producción esta rama se elimina del bundle.
VITE_APPCHECK_DEBUG_TOKEN=

# GitHub OAuth App — client_id PÚBLICO (aparece en el build). Habilita el botón "Conectar con GitHub".
# Déjalo vacío para mantener solo el flujo manual de token (PAT).
VITE_GITHUB_CLIENT_ID=
# El client_secret NO va aquí. Se configura como variable/secreto del entorno de Cloudflare Pages
# (Settings → Environment variables) con el nombre GITHUB_CLIENT_SECRET, y lo lee functions/api/github-oauth.ts.
# Para desarrollo local con `wrangler pages dev`, ponlo en un fichero .dev.vars (git-ignorado):
#   GITHUB_CLIENT_ID=xxxx
#   GITHUB_CLIENT_SECRET=yyyy
