# Ignorar datos de usuario locales
# (incluida la lista de erratas, que se deriva de myGames.json y es igual de personal)
erratas-biblioteca.md
/data/myGames.json
/myGames.json

# Ignorar dependencias y artefactos de Node
/node_modules
/npm-debug.log*
/yarn-debug.log*
/yarn-error.log*
/pnpm-debug.log*

# Ignorar build output (autogenerado por Vite)
/dist/
/dist/assets/
/coverage/

# Estado local de wrangler (`wrangler pages dev`): el KV simulado en disco, con datos de prueba.
/.wrangler/

# Ignorar archivos de sistema y editores
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Secretos del runtime de Pages en LOCAL (`wrangler pages dev` los lee de aquí). Mismo papel que
# `wrangler pages secret put` en el desplegado, pero en claro y en disco: NUNCA al repo.
.dev.vars
.dev.vars.*
# …salvo la PLANTILLA sin valores, que sí se versiona: es donde se documenta qué secretos hacen falta.
!.dev.vars.example

# Ignorar archivos de entorno
.env
.env.local
.env.*.local

# Ignorar logs y temporales
logs
*.log
*.tmp
*.temp

# Ignorar generados por GitHub Actions
.github/workflows/*.retry

# Privacy audit report (generated)
audit-report.json

# Respaldo de `scripts/purge-profile-pii.js`: contiene los tokens y los ids de gist que se van a borrar de
# `profiles`. Es material sensible y de un solo uso; nunca puede acabar en un commit.
profile-legacy-backup-*.json

# Clave de servicio de Firebase. Lo correcto es tenerla FUERA del repositorio (los scripts lo avisan), pero la
# variable GOOGLE_APPLICATION_CREDENTIALS se apunta a menudo aquí por comodidad y basta un `git add .` para
# publicarla. Una clave de servicio se salta las reglas y App Check: es la llave maestra del proyecto.
service-account*.json
*-service-account.json
firebase-adminsdk-*.json

# Claude Code: compartir settings.json, ignorar config local/personal
.claude/settings.local.json

# Playwright (smoke e2e): resultados e informes son artefactos de ejecución
/test-results/
/playwright-report/
/blob-report/

# Copia local completa del proyecto. Se ignora para que no pueda colarse en un commit con un `git add .`:
# son ~5 MB que duplican ficheros ya versionados (src, functions, reglas de Firestore, CLAUDE.md).
/base/

# Aviso a los usuarios publicado en LOCAL (lo escribe el plugin `local-announcement-api` de vite.config.ts al
# guardar desde `/admin` con `npm run dev`). Son datos de prueba de una sola máquina.
/.announcement.local.json
